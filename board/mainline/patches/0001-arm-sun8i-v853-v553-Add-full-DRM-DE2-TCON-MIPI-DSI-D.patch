 drivers/gpu/drm/sun4i/sun6i_mipi_dsi.c        |  26 +-
 drivers/gpu/drm/sun4i/sun8i_mixer.c           |   4 +-
 drivers/gpu/drm/sun4i/sun8i_tcon_top.c        |  57 ++--
