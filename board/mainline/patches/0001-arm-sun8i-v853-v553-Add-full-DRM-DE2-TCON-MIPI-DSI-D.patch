diff --git a/arch/arm/boot/dts/allwinner/sun8i-v853-v553-cockpit.dts b/arch/arm/boot/dts/allwinner/sun8i-v853-v553-cockpit.dts
new file mode 100644
index 000000000000..887e84ffb6ed
--- /dev/null
+++ b/arch/arm/boot/dts/allwinner/sun8i-v853-v553-cockpit.dts
@@ -0,0 +1,249 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device Tree Source for Ternary Systems Allwinner V553 AI Smart Cockpit
+ * Target SoC: Allwinner V553 (sun8iw21p1 / sun8i-v853 compatible)
+ * Memory: 128MB DDR3 SIP
+ * Peripherals: UART0 (PH9/PH10), MicroSD MMC0 (PF0-PF5, CD: PF6), USB OTG (MUSB)
+ * Display: 10.26" BOE (wtl1026boe2l) 600x1600 MIPI-DSI, PWM9 Backlight (PD22)
+ * Touchscreen: Goodix GT911 (PH7/PH8, I2C2)
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/pwm/pwm.h>
+#include "sun8i-v853.dtsi"
+
+/ {
+	model = "Ternary Systems V553 AI Smart Cockpit";
+	compatible = "ternary,v553-cockpit", "allwinner,sun8i-v853";
+
+	aliases {
+		serial0 = &uart0;
+		mmc0 = &mmc0;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		bootargs = "earlycon console=ttyS0,115200 root=/dev/mmcblk0p2 rootwait rw panic=10";
+	};
+
+	memory@40000000 {
+		device_type = "memory";
+		reg = <0x40000000 0x08000000>; /* 128MB DDR3 SIP */
+	};
+
+	/* Main 5V power supply from USB Type-C connector */
+	reg_vcc5v: regulator-5v {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-5v";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		regulator-always-on;
+	};
+
+	/* Main 3.3V I/O supply rail (DCDC / LDO on board) */
+	reg_vcc3v3: regulator-3v3 {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-3v3";
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		regulator-always-on;
+		vin-supply = <&reg_vcc5v>;
+	};
+
+	/* Core voltage supply (0.9V nominal) */
+	reg_vcc_core: regulator-core {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc-core";
+		regulator-min-microvolt = <900000>;
+		regulator-max-microvolt = <900000>;
+		regulator-always-on;
+		vin-supply = <&reg_vcc5v>;
+	};
+
+	/* LCD Screen Backlight (GPIO Backlight on PD22) */
+	backlight: backlight {
+		compatible = "gpio-backlight";
+		gpios = <&pio 3 22 GPIO_ACTIVE_HIGH>; /* PD22 */
+		default-on;
+	};
+
+	/* Digital Microphone Audio Sound Card (ALSA SoC) */
+	sound_dmic: sound-dmic {
+		compatible = "simple-audio-card";
+		simple-audio-card,name = "v553-dmic";
+
+		simple-audio-card,cpu {
+			sound-dai = <&dmic>;
+		};
+
+		simple-audio-card,codec {
+			sound-dai = <&dmic_codec>;
+		};
+	};
+
+	dmic_codec: dmic-codec {
+		compatible = "dmic-codec";
+		#sound-dai-cells = <0>;
+	};
+};
+
+&cpu0 {
+	cpu-supply = <&reg_vcc_core>;
+};
+
+&pio {
+	vcc-pb-supply = <&reg_vcc3v3>;
+	vcc-pc-supply = <&reg_vcc3v3>;
+	vcc-pd-supply = <&reg_vcc3v3>;
+	vcc-pe-supply = <&reg_vcc3v3>;
+	vcc-pf-supply = <&reg_vcc3v3>;
+	vcc-ph-supply = <&reg_vcc3v3>;
+};
+
+/* Hardware Debug Console: UART0 on PH9 (TX) and PH10 (RX) */
+&uart0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_ph9_pins>;
+	status = "okay";
+};
+
+/* MicroSD Card: MMC0 on PF0..PF5 with PF6 Card Detect */
+&mmc0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc0_pins>;
+	vmmc-supply = <&reg_vcc3v3>;
+	cd-gpios = <&pio 5 6 GPIO_ACTIVE_LOW>; /* PF6 */
+	disable-wp;
+	bus-width = <4>;
+	status = "okay";
+};
+
+/* AltoBeam ATBM6165 SDIO Wi-Fi Bus: MMC1 on PE0..PE5 */
+&mmc1 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&mmc1_pins>;
+	vmmc-supply = <&reg_vcc3v3>;
+	bus-width = <4>;
+	no-mmc;
+	no-sd;
+	cap-sd-highspeed;
+	cap-sdio-irq;
+	keep-power-in-suspend;
+	non-removable;
+	status = "okay";
+};
+
+/* USB 2.0 OTG Controller & PHY */
+&usbphy {
+	usb0_vbus-supply = <&reg_vcc5v>;
+	status = "okay";
+};
+
+&usb_otg {
+	dr_mode = "peripheral";
+	status = "okay";
+};
+
+/* Goodix GT911 Capacitive Touchscreen on I2C2 */
+&i2c2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2_ph5_pins>;
+	status = "okay";
+
+	touchscreen@5d {
+		compatible = "goodix,gt911";
+		reg = <0x5d>;
+		interrupt-parent = <&pio>;
+		interrupts = <7 7 IRQ_TYPE_EDGE_FALLING>; /* PH7 (Bank 7, Pin 7) */
+		irq-gpios = <&pio 7 7 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&pio 7 8 GPIO_ACTIVE_HIGH>; /* PH8 (Bank 7, Pin 8) */
+		touchscreen-size-x = <600>;
+		touchscreen-size-y = <1600>;
+	};
+};
+
+/* 16MB Factory SPI NOR Flash (XM25QH128C) */
+&spi0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi0_pins>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <50000000>;
+		m25p,fast-read;
+	};
+};
+
+/* Hardware Watchdog & System Restart Engine */
+&wdt {
+	status = "okay";
+};
+
+/* Allwinner DE2 DRM Display Engine Pipeline */
+&de {
+	status = "okay";
+};
+
+&display_clocks {
+	status = "okay";
+};
+
+&mixer0 {
+	status = "okay";
+};
+
+&tcon_top {
+	status = "okay";
+};
+
+&tcon_lcd0 {
+	status = "okay";
+};
+
+&dphy {
+	status = "okay";
+};
+
+&dsi {
+	vcc-dsi-supply = <&reg_vcc3v3>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&dsi_2lane_pins>;
+	status = "okay";
+
+	panel@0 {
+		compatible = "boe,wtl1026boe2l";
+		reg = <0>;
+		reset-gpios = <&pio 4 14 GPIO_ACTIVE_HIGH>; /* PE14 */
+		enable-gpios = <&pio 3 17 GPIO_ACTIVE_HIGH>; /* PD17 */
+		rotation = <90>;
+		backlight = <&backlight>;
+	};
+};
+
+
+/* AltoBeam ATBM6165 Bluetooth 5.4 HCI Controller on UART3 */
+&uart3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart3_pa_pins>;
+	uart-has-rtscts;
+	status = "okay";
+
+	bluetooth {
+		compatible = "altobeam,atbm603x-bt";
+		enable-gpios = <&pio 4 15 GPIO_ACTIVE_HIGH>; /* PE15: BT_REG_ON */
+	};
+};
+
+/* Allwinner Digital Microphone Controller (DMIC) */
+&dmic {
+	pinctrl-names = "default";
+	pinctrl-0 = <&dmic_ph0_pins>;
+	status = "okay";
+};
diff --git a/arch/arm/boot/dts/allwinner/sun8i-v853.dtsi b/arch/arm/boot/dts/allwinner/sun8i-v853.dtsi
index 4ecc97c7e7c0..6a220ef1b2fa 100644
--- a/arch/arm/boot/dts/allwinner/sun8i-v853.dtsi
+++ b/arch/arm/boot/dts/allwinner/sun8i-v853.dtsi
@@ -8,6 +8,10 @@
 #include <dt-bindings/reset/sun8i-v853-ccu.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/power/allwinner,sun8i-v853-ppu.h>
+#include <dt-bindings/clock/sun8i-tcon-top.h>
+#include <dt-bindings/clock/sun8i-de2.h>
+#include <dt-bindings/reset/sun8i-de2.h>
+
 
 / {
 	#address-cells = <1>;
@@ -46,6 +50,13 @@ pmu {
 		interrupt-parent = <&gic>;
 	};
 
+	
+	de: display-engine {
+		compatible = "allwinner,sun20i-d1-display-engine";
+		allwinner,pipelines = <&mixer0>;
+		status = "disabled";
+	};
+
 	timer {
 		compatible = "arm,armv7-timer";
 		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(2) | IRQ_TYPE_LEVEL_LOW)>,	/* Secure Phys IRQ */
@@ -103,6 +114,13 @@ dsi_2lane_pins: dsi-2lane-pins {
 				function = "dsi";
 			};
 
+			/omit-if-no-ref/
+			pwm9_pd22_pin: pwm9-pd22-pin {
+				pins = "PD22";
+				function = "pwm9";
+			};
+
+
 			/omit-if-no-ref/
 			spi0_pins: spi0-pins {
 				pins = "PC0", "PC1", "PC2", "PC3", "PC4", "PC5";
@@ -115,6 +133,13 @@ spi3_pins: spi3-pins {
 				function = "spi3";
 			};
 
+			/omit-if-no-ref/
+			i2c2_ph5_pins: i2c2-ph5-pins {
+				pins = "PH5", "PH6";
+				function = "i2c2";
+				bias-pull-up;
+			};
+
 			/omit-if-no-ref/
 			i2c2_ph11_pins: i2c2-ph11-pins {
 				pins = "PH11", "PH12";
@@ -158,6 +183,18 @@ dmic_ph9_pins: dmic-ph9-pins {
 				pins = "PH9", "PH10";
 				function = "dmic";
 			};
+
+			/omit-if-no-ref/
+			uart3_pa_pins: uart3-pa-pins {
+				pins = "PA16", "PA17", "PA18", "PA19";
+				function = "uart3";
+			};
+
+			/omit-if-no-ref/
+			dmic_ph0_pins: dmic-ph0-pins {
+				pins = "PH0", "PH1", "PH2", "PH3", "PH4";
+				function = "dmic";
+			};
 		};
 
 		pwm: pwm@2000c00 {
@@ -208,6 +245,21 @@ i2s0: i2s@2032000 {
 			#sound-dai-cells = <0>;
 		};
 
+		dmic: dmic@2031000 {
+			compatible = "allwinner,sun20i-d1-dmic",
+				     "allwinner,sun50i-h6-dmic";
+			reg = <0x2031000 0x400>;
+			interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_DMIC>,
+				 <&ccu CLK_DMIC>;
+			clock-names = "bus", "mod";
+			resets = <&ccu RST_BUS_DMIC>;
+			dmas = <&dma 8>;
+			dma-names = "rx";
+			status = "disabled";
+			#sound-dai-cells = <0>;
+		};
+
 		i2s1: i2s@2033000 {
 			compatible = "allwinner,sun50i-r329-i2s";
 			reg = <0x2033000 0x1000>;
@@ -634,6 +686,150 @@ ohci0: usb@4101400 {
 			status = "disabled";
 		};
 
+		
+		display_clocks: clock-controller@5000000 {
+			compatible = "allwinner,sun20i-d1-de2-clk",
+				     "allwinner,sun50i-h5-de2-clk";
+			reg = <0x5000000 0x10000>;
+			clocks = <&ccu CLK_BUS_DE>, <&ccu CLK_DE>;
+			clock-names = "bus", "mod";
+			resets = <&ccu RST_BUS_DE>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		mixer0: mixer@5100000 {
+			compatible = "allwinner,sun20i-d1-de2-mixer-0";
+			reg = <0x5100000 0x100000>;
+			clocks = <&display_clocks CLK_BUS_MIXER0>,
+				 <&display_clocks CLK_MIXER0>;
+			clock-names = "bus", "mod";
+			resets = <&display_clocks RST_MIXER0>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				mixer0_out: port@1 {
+					reg = <1>;
+
+					mixer0_out_tcon_top_mixer0: endpoint {
+						remote-endpoint = <&tcon_top_mixer0_in_mixer0>;
+					};
+				};
+			};
+		};
+
+		dsi: dsi@5450000 {
+			compatible = "allwinner,sun50i-a100-mipi-dsi";
+			reg = <0x5450000 0x1000>;
+			interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_MIPI_DSI>,
+				 <&tcon_top CLK_TCON_TOP_DSI>;
+			clock-names = "bus", "mod";
+			resets = <&ccu RST_BUS_MIPI_DSI>;
+			phys = <&dphy>;
+			phy-names = "dphy";
+			status = "disabled";
+
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port {
+				dsi_in_tcon_lcd0: endpoint {
+					remote-endpoint = <&tcon_lcd0_out_dsi>;
+				};
+			};
+		};
+
+		dphy: phy@5451000 {
+			compatible = "allwinner,sun50i-a100-mipi-dphy";
+			reg = <0x5451000 0x1000>;
+			interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_MIPI_DSI>,
+				 <&ccu CLK_MIPI_DSI>;
+			clock-names = "bus", "mod";
+			resets = <&ccu RST_BUS_MIPI_DSI>;
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
+		tcon_top: tcon-top@5460000 {
+			compatible = "allwinner,sun20i-d1-tcon-top";
+			reg = <0x5460000 0x1000>;
+			clocks = <&ccu CLK_BUS_DPSS_TOP>,
+				 <&ccu CLK_TCON_LCD>,
+				 <&ccu CLK_TCON_LCD>;
+			clock-names = "bus", "tcon-tv0", "dsi";
+			clock-output-names = "tcon-top-tv0", "tcon-top-dsi";
+			resets = <&ccu RST_BUS_DPSS_TOP>;
+			#clock-cells = <1>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				tcon_top_mixer0_in: port@0 {
+					reg = <0>;
+
+					tcon_top_mixer0_in_mixer0: endpoint {
+						remote-endpoint = <&mixer0_out_tcon_top_mixer0>;
+					};
+				};
+
+				tcon_top_mixer0_out: port@1 {
+					reg = <1>;
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					tcon_top_mixer0_out_tcon_lcd0: endpoint@0 {
+						reg = <0>;
+						remote-endpoint = <&tcon_lcd0_in_tcon_top_mixer0>;
+					};
+				};
+			};
+		};
+
+		tcon_lcd0: lcd-controller@5461000 {
+			compatible = "allwinner,sun20i-d1-tcon-lcd";
+			reg = <0x5461000 0x1000>;
+			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_BUS_TCON_LCD>,
+				 <&ccu CLK_TCON_LCD>;
+			clock-names = "ahb", "tcon-ch0";
+			clock-output-names = "tcon-pixel-clock";
+			resets = <&ccu RST_BUS_TCON_LCD>;
+			reset-names = "lcd";
+			#clock-cells = <0>;
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				tcon_lcd0_in: port@0 {
+					reg = <0>;
+
+					tcon_lcd0_in_tcon_top_mixer0: endpoint {
+						remote-endpoint = <&tcon_top_mixer0_out_tcon_lcd0>;
+					};
+				};
+
+				tcon_lcd0_out: port@1 {
+					#address-cells = <1>;
+					#size-cells = <0>;
+					reg = <1>;
+
+					tcon_lcd0_out_dsi: endpoint@1 {
+						reg = <1>;
+						remote-endpoint = <&dsi_in_tcon_lcd0>;
+							};
+				};
+			};
+		};
+
 		ppu: power-controller@7001000 {
 			compatible = "allwinner,sun8i-v853-ppu";
 			reg = <0x7001000 0x400>;
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 987a08702410..1d0b08f5ff2a 100644
--- a/drivers/gpu/drm/panel/Makefile
