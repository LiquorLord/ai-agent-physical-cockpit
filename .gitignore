# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Large firmware images and raw dumps
factory_reverse/backups/*.bin
factory_reverse/backups/*.bin.sha256
factory_reverse/rootfs/*.squashfs
factory_reverse/rootfs/rootfs_extracted/
firmware/splash/*.raw

# Compiled binaries
firmware/bin/*
factory_reverse/flasher/flash_tool
factory_reverse/flasher/sunxi-tools/sunxi-fel

# Scratch & Logs
scratch/*
!scratch/.gitkeep
factory_reverse/logs/*.log

# Temporary and editor files
.DS_Store
*.swp
*~

# Buildroot workspace large trees & scratch
buildroot_workspace/buildroot/
buildroot_workspace/.*_del/
buildroot_workspace/binaries/
factory_reverse/backups/factory_zImage

# Release output large disk images
output/
logs/
factory_reverse/factory_vmlinux.bin
archive/**/*.bin
firmware/backup_sdcard_phase7/
buildroot_workspace/patches/glibc_patched/
